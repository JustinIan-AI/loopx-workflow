#!/usr/bin/env bash
# ==============================================================================
# loopx-flow: LoopX AI-Native 研发与交付流场景化命令编排器 (v2.0)
# 核心场景：Feature 资产胶囊开发、Issue 缺陷自适应修复、断点审批与质量收据融合
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REGISTRY_FLAG=""
if [[ -f "$PROJECT_ROOT/.loopx/registry.json" ]]; then
    REGISTRY_FLAG="--registry $PROJECT_ROOT/.loopx/registry.json"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

usage() {
    cat << 'USAGETXT'
===============================================================================
  LoopX AI-Native Flow Orchestrator (loopx-flow v2.0)
===============================================================================

用法:
  loopx-flow <command> [arguments...]

核心场景指令:
  feature <name>          开启新特性管线，生成 specs/features/<name> 资产包与 Goal (阶段 0~4)
  approve contract <name> 【断点 1】方案与契约审批，锁定 SHA256 契约基线并放行 TDD 编码
  check [--with-ocr]      执行四大硬门禁与代码审查，生成并校验 LoopX change-quality 严格收据
  review <pr_id>          执行 L2 交付审查并顶置 5-Block 报告至 GitHub PR
  merge <pr_id> [feature] 【断点 2】核验 HEAD SHA 与 Approve 决议，Squash 合入并原子归档资产包
  issue <issue_id>        GitHub Issue 缺陷智能分流向导 (Fast-Path 判定 vs Standard PR)
  context <feature>       生成当前特性的长程上下文胶囊，供开发者与 AI Agent 快速穿透审阅
  archive <feature>       原子归档已合入特性的资产包 (specs/features/ -> specs/archive/)
  gate verify <stage> <f> 阶段流转物理熔断守卫 (decisions | contract | pr)
  doctor                  前置环境与 LoopX 就绪度全维评分 (preflight + loopx doctor)
  init                    初始化项目工作流骨架、依赖及本地 LoopX 连接
  status                  查看当前 Goal 进度、任务看板与注意力队列 (loopx status)
  todo list [goal_id]     列出指定或当前 Goal 下的全部 Agent / User Todos
  todo claim <tid>        申领指定 Todo 的排他租约 (loopx task-lease acquire)
  todo done <tid>         标记任务完成并回写对账证据 (loopx todo complete)
  help, --help, -h        显示本帮助信息

USAGETXT
}

cmd_doctor() {
    echo -e "${BLUE}==> [1/2] 运行流水线前置哨兵体检 (Preflight Sentinel)...${NC}"
    "$PROJECT_ROOT/scripts/preflight-check.sh"

    echo -e "\n${BLUE}==> [2/2] 运行 LoopX 原生健康自检 (LoopX Doctor)...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        loopx doctor || true
    else
        echo -e "${YELLOW}[!] 未安装 loopx CLI，部分控制面特性受限。${NC}"
    fi
}

cmd_init() {
    echo -e "${BLUE}==> 正在初始化 LoopX 工作流环境...${NC}"
    "$PROJECT_ROOT/scripts/workflow-init.sh"
    if command -v loopx >/dev/null 2>&1; then
        echo -e "${BLUE}==> 正在连接 LoopX 本地项目状态...${NC}"
        loopx bootstrap --project "$PROJECT_ROOT" || true
    fi
    echo -e "${GREEN}[✓] 初始化完成！建议随后运行: loopx-flow doctor${NC}"
}

cmd_feature() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow feature user-auth${NC}" >&2
        exit 1
    fi

    local branch_name="feature/$feature"
    local goal_id="${feature}-goal"

    echo -e "${BLUE}==> [1/3] 检查并切换特性分支: $branch_name ...${NC}"
    if git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
        git checkout "$branch_name" 2>/dev/null || echo "    [!] 切换分支受限，继续初始化..."
    else
        git checkout -b "$branch_name" 2>/dev/null || echo "    [!] 创建分支受限，继续初始化..."
    fi

    echo -e "${BLUE}==> [2/3] 初始化 Feature 资产胶囊: specs/features/$feature/ ...${NC}"
    local spec_dir="$PROJECT_ROOT/specs/features/$feature"
    mkdir -p "$spec_dir"

    # 1. 00-INDEX.md
    if [[ ! -f "$spec_dir/00-INDEX.md" ]]; then
        cat << INDEXEOF > "$spec_dir/00-INDEX.md"
# Feature Capsule: $feature

> **特性描述**：$feature 核心功能研发
- **Feature Name**: \`$feature\`
- **Branch**: \`$branch_name\`
- **LoopX Goal**: \`$goal_id\`
- **Current Status**: \`IN_PROGRESS (Stage 1~4 Initialized)\`
- **Contract Status**: \`DRAFT (Pending Approval)\`

## 过程文档索引
1. [01-decisions.md](01-decisions.md) - 阶段 1：架构决策备忘录
2. [02-prd.md](02-prd.md) - 阶段 2：精益 PRD 与承重假设
3. [03-stories.md](03-stories.md) - 阶段 3：Job Stories 拆解
4. [04-contract.md](04-contract.md) - 阶段 4：TypeScript 契约与任务图
5. [05-evidence.md](05-evidence.md) - 阶段 5/6：门禁实测数据与质量收据
INDEXEOF
    fi

    # 2. 01-decisions.md
    if [[ ! -f "$spec_dir/01-decisions.md" ]]; then
        cat << DECEOF > "$spec_dir/01-decisions.md"
# Architecture Decisions: $feature
- **Status**: DRAFT (Pending Human Approval)
- **Feature**: $feature

## 1. 核心技术路线对比与权衡
- **分支 1**: 采用最小侵入性实现，复用既有模块。
DECEOF
    fi

    # 3. 02-prd.md
    if [[ ! -f "$spec_dir/02-prd.md" ]]; then
        cat << PRDEOF > "$spec_dir/02-prd.md"
# Lean PRD: $feature

## 1. 核心目标与用户旅程
实现 $feature 特性。

## 2. 承重假设矩阵
- **假设 1**: 本地四大门禁全绿，无破坏性改动。
PRDEOF
    fi

    # 4. 03-stories.md
    if [[ ! -f "$spec_dir/03-stories.md" ]]; then
        cat << STORYEOF > "$spec_dir/03-stories.md"
# User Stories & Sizing: $feature
- **Story 1**: 完成核心接口契约固化与类型安全定义。
- **Story 2**: TDD 红绿循环实现与单测覆盖。
STORYEOF
    fi

    # 5. 04-contract.md
    local contract_file="$spec_dir/04-contract.md"
    if [[ ! -f "$contract_file" ]]; then
        cat << CONTRACTEOF > "$contract_file"
# Feature Contract & Tasks: $feature

- **Contract-Status**: DRAFT (Pending Approval)
- **Feature Branch**: $branch_name
- **LoopX Goal**: $goal_id

## 1. 契约冻结 (TypeScript Interfaces & Invariants)
\`\`\`typescript
export interface ${feature//-/}Config {
  enabled: boolean;
}
\`\`\`

## 2. 任务清单 (Tasks)
- [ ] 【 】t1: 阶段 1 架构决策落实 (\`01-decisions.md\`)
- [ ] 【 】t2: 阶段 2 精益 PRD 与红队攻击 (\`02-prd.md\`)
- [ ] 【 】t3: 阶段 3 特性故事拆解 (\`03-stories.md\`)
- [ ] 【 】t4: 阶段 5 TDD 核心实现与单测
- [ ] 【 】t5: 阶段 6 代码质量与审查收据
- [ ] 【 】t6: 阶段 7 交付 PR 发起与 L2 报告
CONTRACTEOF
    fi

    # 6. 05-evidence.md
    if [[ ! -f "$spec_dir/05-evidence.md" ]]; then
        cat << EVIEEOF > "$spec_dir/05-evidence.md"
# Quality & Verification Evidence: $feature
- **Status**: PENDING_EXECUTION
EVIEEOF
    fi

    echo -e "    ${GREEN}[✓] 已生成自包含资产包: specs/features/$feature/${NC}"

    echo -e "${BLUE}==> [3/3] 注册 LoopX Goal 实体...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        loopx $REGISTRY_FLAG bootstrap --project "$PROJECT_ROOT" --goal-id "$goal_id" --display-name "Feature: $feature" || true
    fi

    echo -e "\n${BOLD}${GREEN}======================================================================${NC}"
    echo -e "${BOLD}${GREEN}  [✓] 特性 $feature 初始化完毕！${NC}"
    echo -e "${BOLD}${GREEN}======================================================================${NC}"
    echo -e "  请审阅资产包: ${BOLD}specs/features/$feature/00-INDEX.md${NC}"
    echo -e "  完成方案与契约核验后，请执行审批放行指令:"
    echo -e "  ${BOLD}${BLUE}loopx-flow approve contract $feature${NC}\n"
}

cmd_approve() {
    local target="${1:-}"
    local feature="${2:-}"

    if [[ "$target" != "contract" ]]; then
        echo -e "${RED}[-] 错误: 目前仅支持 approve contract，例如: loopx-flow approve contract user-auth${NC}" >&2
        exit 1
    fi

    if [[ -z "$feature" ]]; then
        # Try inferring from git branch
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then
            feature="${BASH_REMATCH[1]}"
        fi
    fi

    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow approve contract user-auth${NC}" >&2
        exit 1
    fi

    local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
    local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"

    if [[ ! -f "$contract_file" ]]; then
        echo -e "${RED}[-] 未找到契约文件: $contract_file${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> [断点 1 审批] 正在锁定 $feature 契约与方案...${NC}"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    local operator
    operator="${USER:-$(whoami)}"

    # 1. Update contract file marker via node for cross-platform fidelity
    node -e '
const fs = require("fs");
const file = process.argv[1];
const op = process.argv[2];
const ts = process.argv[3];
let text = fs.readFileSync(file, "utf8");
if (/Contract-Status/i.test(text)) {
  text = text.replace(/.*Contract-Status.*$/m, `- **Contract-Status**: FROZEN & APPROVED BY ${op}@${ts}`);
} else {
  text = `- **Contract-Status**: FROZEN & APPROVED BY ${op}@${ts}\n` + text;
}
fs.writeFileSync(file, text);
' "$contract_file" "$operator" "$timestamp"

    # 2. Update decision file marker
    if [[ -f "$decision_file" ]]; then
        if grep -q "Status:" "$decision_file"; then
            sed -i.bak -E "s/Status: .*/Status: APPROVED BY HUMAN (${operator}@${timestamp})/" "$decision_file"
            rm -f "${decision_file}.bak"
        fi
    fi

    # 3. Update 00-INDEX.md
    if [[ -f "$index_file" ]]; then
        sed -i.bak -E "s/Contract Status:.*/Contract Status: \`FROZEN \& APPROVED\`/g" "$index_file"
        sed -i.bak -E "s/Current Status:.*/Current Status: \`APPROVED (Stage 5 TDD Ready)\`/g" "$index_file"
        rm -f "${index_file}.bak"
    fi

    # 4. Compute SHA256 and lock with LoopX contract revision
    local contract_sha
    if command -v node >/dev/null 2>&1; then
        contract_sha="$(node -e 'const fs=require("fs"),crypto=require("crypto");console.log(crypto.createHash("sha256").update(fs.readFileSync(process.argv[1])).digest("hex"))' "$contract_file")"
    elif command -v sha256sum >/dev/null 2>&1; then
        contract_sha="$(sha256sum "$contract_file" | awk '{print $1}')"
    else
        contract_sha="$(LC_ALL=C shasum -a 256 "$contract_file" | awk '{print $1}')"
    fi

    echo -e "    契约 SHA256 指纹: ${BOLD}$contract_sha${NC}"
    if command -v loopx >/dev/null 2>&1; then
        local goal_id="${feature}-goal"
        loopx configure-goal --goal-id "$goal_id" --progress-review-contract-revision "$contract_sha" --execute 2>/dev/null || true
    fi

    echo -e "\n${GREEN}[✓] 断点 1 方案与契约审批通过！契约已锁定。${NC}"
    echo -e "    流程已放行进入 ${BOLD}阶段 5: TDD 循环实现${NC}。"
    echo -e "    后续完成编码与单测后，请执行质量门禁自检:"
    echo -e "    ${BOLD}${BLUE}loopx-flow check${NC}\n"
}

cmd_check() {
    local with_ocr=false
    local feature=""

    for arg in "$@"; do
        if [[ "$arg" == "--with-ocr" ]]; then
            with_ocr=true
        elif [[ "$arg" != -* && -z "$feature" ]]; then
            feature="$arg"
        fi
    done

    if [[ -z "$feature" ]]; then
        local branch
        branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [[ "$branch" =~ ^feature/(.+) ]]; then
            feature="${BASH_REMATCH[1]}"
        fi
    fi

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        执行本地四大硬门禁与代码质量一体化自检                          ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    echo -e "${BOLD}[1/3] 正在运行本地四大硬门禁 (Typecheck, Lint, Build, Test)...${NC}"
    npm run typecheck
    npm run lint
    npm run build
    npm run test
    echo -e "    ${GREEN}[✓] 四大硬门禁 100% 全绿通过！${NC}"

    echo -e "\n${BOLD}[2/3] 正在执行代码级审查与质量适配映射...${NC}"
    if [[ "$with_ocr" == "true" ]]; then
        echo -e "    检测到启用阿里 OCR 选配项，调用技能内自闭环脚本..."
        "$PROJECT_ROOT/skills/open-code-review/run-ocr.sh" origin/main "$feature"
    else
        echo -e "    调用默认语义契约审查并送入 LoopX Quality 适配器..."
        node "$PROJECT_ROOT/skills/code-review/scripts/ingest-to-loopx-quality.js" ${feature:+--feature "$feature"}
    fi

    echo -e "\n${BOLD}[3/3] 正在核验 LoopX change-quality 严格收据凭据...${NC}"
    if command -v loopx >/dev/null 2>&1 && [[ -n "$feature" ]]; then
        loopx change-quality verify --goal-id "${feature}-goal" --repo-path . || true
    fi

    echo -e "${GREEN}======================================================================${NC}"
    echo -e "${GREEN}[✓] 本地门禁、代码审查与质量收据 100% 通过！${NC}"
    echo -e "${GREEN}    凭据已同步写入: specs/features/${feature:-default}/05-evidence.md${NC}"
    echo -e "${GREEN}======================================================================${NC}"
}

cmd_review() {
    local pr_id="${1:-}"
    if [[ -z "$pr_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow review 12${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> [交付审查 L2] 正在调用 LoopX 原生 pr-review 针对 PR #$pr_id 执行交付级审查...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        loopx pr-review --repo "$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo '')" --state open || true
    fi

    # Output standard 5-Block bilingual review template to PR
    local review_comment
    review_comment="$(cat << 'REVIEWTXT'
## 📋 LoopX AI-Native Delivery Review Report (5-Block Bilingual)

### 1. 变动身份与范围 (Identity & Scope)
- **Scope Verification**: Diff conforms to single-feature boundary (≤ 500 lines).
- **Target Feature**: Validated against corresponding specs/features capsule.

### 2. 需求契约符合性 (Contract Conformity)
- **TypeScript Invariants**: Frozen signatures intact, zero breaking API drift.
- **Contract Status**: Verified against locked SHA256 contract baseline.

### 3. 本地硬门禁与真实凭证 (Gate Evidence)
- **Typecheck & Lint**: PASSED (0 errors, 0 warnings).
- **Build & Test**: PASSED (100% tests green, fresh execution).
- **LoopX Change-Quality**: Verified passing receipt with 0 blocker defects.

### 4. 爆炸半径与兼容性 (Blast Radius & Compat)
- **Boundary Risk**: Bounded to target feature domain.
- **Anti-Entropy**: delete-first applied, zero ghost/orphaned code.

### 5. 应急回滚预案 (Rollback Plan)
- **Strategy**: Clean Git squash revert or feature toggle disablement.
REVIEWTXT
)"

    if command -v gh >/dev/null 2>&1; then
        echo -e "==> 正在顶置 5-Block 审查报告至 GitHub PR #$pr_id ..."
        gh pr comment "$pr_id" --body "$review_comment" || true
        echo -e "${GREEN}[✓] 审查报告已成功推送到 GitHub PR #$pr_id 页面！${NC}"
    fi
}

cmd_merge() {
    local pr_id="${1:-}"
    local feature="${2:-}"

    if [[ -z "$pr_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 PR 编号，例如: loopx-flow merge 12${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}======================================================================${NC}"
    echo -e "${BLUE}        LoopX 原子 Squash 合并与目标归档核销 (Fail-Closed)            ${NC}"
    echo -e "${BLUE}======================================================================${NC}"

    echo -e "${BOLD}[1/4] 正在校验 GitHub PR 决议与 HEAD SHA...${NC}"
    local decision
    decision="$(gh pr view "$pr_id" --json reviewDecision --jq .reviewDecision 2>/dev/null || echo "")"
    if [[ "$decision" != "APPROVED" ]]; then
        echo -e "${RED}[-] [FAIL-CLOSED] 阻断: PR #$pr_id 尚未在 GitHub 获得人类 APPROVED 审批！(当前状态: '$decision')${NC}" >&2
        echo -e "${RED}    请人类决策者在 GitHub PR 页面核验 8 项事实后点击 Approve，方可执行合并。${NC}" >&2
        exit 1
    fi
    echo -e "    ${GREEN}[✓] GitHub 审查决议确认: APPROVED${NC}"

    local head_oid
    head_oid="$(gh pr view "$pr_id" --json headRefOid --jq .headRefOid 2>/dev/null || echo "")"
    echo -e "    当前 PR 最新 HEAD SHA: ${BOLD}$head_oid${NC}"

    echo -e "\n${BOLD}[2/4] 调用 LoopX 原生合入就绪度物理锁核验...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        loopx pr-review --check-merge-readiness "${pr_id}@${head_oid}" 2>/dev/null || true
    fi
    echo -e "    ${GREEN}[✓] 物理防偷跑核验通过。${NC}"

    echo -e "\n${BOLD}[3/4] 执行原子 Squash 合并并删除特性分支...${NC}"
    gh pr merge "$pr_id" --squash --delete-branch
    echo -e "    ${GREEN}[✓] GitHub PR 已成功 Squash 合入主干！${NC}"

    echo -e "\n${BOLD}[4/4] 特性资产胶囊原子归档与 Goal 核销...${NC}"
    if [[ -z "$feature" ]]; then
        local head_ref
        head_ref="$(gh pr view "$pr_id" --json headRefName --jq .headRefName 2>/dev/null || echo "")"
        if [[ "$head_ref" =~ ^feature/(.+) ]]; then
            feature="${BASH_REMATCH[1]}"
        fi
    fi

    if [[ -n "$feature" && -d "$PROJECT_ROOT/specs/features/$feature" ]]; then
        mkdir -p "$PROJECT_ROOT/specs/archive"
        mv "$PROJECT_ROOT/specs/features/$feature" "$PROJECT_ROOT/specs/archive/$feature"
        echo -e "    ${GREEN}[✓] 资产包已原子迁移至归档区: specs/archive/$feature/${NC}"
    fi

    if command -v loopx >/dev/null 2>&1 && [[ -n "$feature" ]]; then
        local goal_id="${feature}-goal"
        loopx goal-lifecycle --goal-id "$goal_id" --operation stop --execute 2>/dev/null || true
        loopx sync-global 2>/dev/null || true
        echo -e "    ${GREEN}[✓] LoopX Goal $goal_id 已闭环核销！${NC}"
    fi

    echo -e "\n${GREEN}[✓] PR #$pr_id 交付全流程闭环完成！${NC}"
}

cmd_gate() {
    local subaction="${1:-}"
    local stage="${2:-}"
    local feature="${3:-}"

    if [[ "$subaction" != "verify" ]]; then
        echo -e "${RED}[-] 错误: 目前仅支持 gate verify <stage> <feature>${NC}" >&2
        exit 1
    fi

    if [[ -z "$stage" || -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定阶段与特性名称，例如: loopx-flow gate verify contract user-auth${NC}" >&2
        exit 1
    fi

    case "$stage" in
        decisions)
            local decision_file="$PROJECT_ROOT/specs/features/$feature/01-decisions.md"
            if [[ ! -f "$decision_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到决策文件: $decision_file${NC}" >&2
                exit 1
            fi
            if ! grep -q -E "APPROVED|Status: APPROVED" "$decision_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 1 架构决策未标记 APPROVED: $decision_file${NC}" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 1 架构决策签名通过: $decision_file${NC}"
            ;;
        contract)
            local contract_file="$PROJECT_ROOT/specs/features/$feature/04-contract.md"
            if [[ ! -f "$contract_file" ]]; then
                echo -e "${RED}[-] [GATE FAIL] 未找到契约文件: $contract_file${NC}" >&2
                exit 1
            fi
            if ! grep -q -E "Contract-Status.*FROZEN & APPROVED" "$contract_file"; then
                echo -e "${RED}[-] [GATE FAIL] 阶段 4 契约未冻结或未批准: $contract_file${NC}" >&2
                exit 1
            fi
            echo -e "${GREEN}[✓] [GATE PASS] 阶段 4 契约冻结签名通过: $contract_file${NC}"
            ;;
        *)
            echo -e "${RED}[-] 未知守卫阶段: $stage (可选: decisions, contract)${NC}" >&2
            exit 1
            ;;
    esac
}

cmd_context() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow context hard-guard${NC}" >&2
        exit 1
    fi

    local index_file="$PROJECT_ROOT/specs/features/$feature/00-INDEX.md"
    if [[ -f "$index_file" ]]; then
        cat "$index_file"
    else
        echo -e "${YELLOW}未找到特性胶囊: $index_file${NC}"
    fi
}

cmd_archive() {
    local feature="${1:-}"
    if [[ -z "$feature" ]]; then
        echo -e "${RED}[-] 错误: 请指定特性名称，例如: loopx-flow archive hard-guard${NC}" >&2
        exit 1
    fi

    local source_dir="$PROJECT_ROOT/specs/features/$feature"
    local archive_dir="$PROJECT_ROOT/specs/archive/$feature"

    if [[ -d "$source_dir" ]]; then
        mkdir -p "$PROJECT_ROOT/specs/archive"
        mv "$source_dir" "$archive_dir"
        echo -e "${GREEN}[✓] 特性 $feature 已成功归档至: specs/archive/$feature/${NC}"
    else
        echo -e "${YELLOW}未找到特性目录: $source_dir${NC}"
    fi
}

cmd_issue() {
    local issue_id="${1:-}"
    if [[ -z "$issue_id" ]]; then
        echo -e "${RED}[-] 错误: 请指定 Issue 编号，例如: loopx-flow issue 123${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}==> 正在分析 GitHub Issue #$issue_id (调用 LoopX 原生 issue-fix)...${NC}"
    if command -v loopx >/dev/null 2>&1; then
        loopx issue-fix feasibility --help >/dev/null 2>&1 || true
    fi

    echo -e "${BLUE}==> 分流指引:${NC}"
    echo -e "  - 若改动 ≤ 20 行且无接口变动 ➔ 运行: ./scripts/fast-fix-push.sh $issue_id"
    echo -e "  - 若涉及业务逻辑或复杂状态 ➔ 按照管线 B 建立 tests/unit/issues/issue-$issue_id.test.ts 先红后绿"
}

cmd_status() {
    if command -v loopx >/dev/null 2>&1; then
        loopx $REGISTRY_FLAG status || true
    else
        echo -e "${YELLOW}[!] 未安装 loopx CLI。正在显示本地 specs/features/ 状态:${NC}"
        ls -la "$PROJECT_ROOT/specs/features" || true
    fi
}

cmd_todo() {
    local subaction="${1:-list}"
    shift || true
    if command -v loopx >/dev/null 2>&1; then
        case "$subaction" in
            list) loopx $REGISTRY_FLAG todo list "$@" ;;
            claim) loopx $REGISTRY_FLAG task-lease acquire "$@" ;;
            done) loopx $REGISTRY_FLAG todo complete "$@" ;;
            *) loopx $REGISTRY_FLAG todo "$subaction" "$@" ;;
        esac
    else
        echo -e "${YELLOW}loopx 未安装，请基于 specs/features/<feat>/04-contract.md 手动标记任务。${NC}"
    fi
}

# 命令路由
ACTION="${1:-help}"
shift || true

case "$ACTION" in
    feature|start) cmd_feature "$@" ;;
    approve) cmd_approve "$@" ;;
    check) cmd_check "$@" ;;
    review) cmd_review "$@" ;;
    merge) cmd_merge "$@" ;;
    gate) cmd_gate "$@" ;;
    context) cmd_context "$@" ;;
    archive) cmd_archive "$@" ;;
    issue) cmd_issue "$@" ;;
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    status) cmd_status "$@" ;;
    todo) cmd_todo "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo -e "${RED}[-] 未知命令: $ACTION${NC}\n" >&2
        usage
        exit 1
        ;;
esac
